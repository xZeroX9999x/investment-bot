# =============================================================================
#  PLANTILLA DE VARIABLES DE ENTORNO
#  Copiar a `.env` y completar. NUNCA commitear el archivo `.env` real.
# =============================================================================

# --- Universo de activos a analizar (separados por coma, sin espacios) ---
TICKER_UNIVERSE=AAPL,MSFT,GOOGL,V,MA,JNJ,PG,KO,PEP,UNH,HD,COST,LMT,ASML,NVO

# --- Parámetros del Filtro Fundamental (Fase 1) ---
MARGEN_BRUTO_MINIMO=0.50          # 50% mínimo de margen bruto
EPS_YEARS_LOOKBACK=5              # Años para evaluar tendencia EPS
SHARES_YEARS_LOOKBACK=3           # Años para validar recompras

# --- Parámetros de Valoración (Fase 2) ---
PER_DISCOUNT_MIN=0.20             # 20% descuento mínimo vs media histórica
PER_HISTORY_YEARS=5               # Ventana histórica del PER
RSI_OVERSOLD_THRESHOLD=30.0       # Umbral RSI sobreventa
RSI_EXTREME_OVERSOLD=20.0         # Umbral RSI sobreventa extrema (con catalizador cercano)
MA_PERIOD=200                     # Periodos para la media móvil
RSI_PERIOD=14                     # Periodos para el cálculo de RSI

# --- Parámetros de Ejecución ---
CONCURRENCY_LIMIT=5               # Llamadas paralelas máximas a yfinance
RETRY_MAX_ATTEMPTS=5              # Reintentos por petición fallida
RETRY_BASE_DELAY=2.0              # Delay base para backoff exponencial (segundos)
SCAN_INTERVAL_SECONDS=3600        # Intervalo entre escaneos completos (1 hora)

# --- Base de datos ---
DATABASE_PATH=./data/arquitecto.db

# --- Alertas Telegram (opcional, dejar vacío para desactivar) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alertas Email SMTP (opcional, dejar vacío para desactivar) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Logging ---
LOG_LEVEL=INFO
LOG_PATH=./logs/arquitecto.jsonl

# --- Modo web (opcional, solo si usas web_runner.py) ---
WEB_HOST=127.0.0.1                # 0.0.0.0 para exponer a la red (usar con auth delante)
WEB_PORT=8765
WEB_LOG_LEVEL=info                # info | warning | error
